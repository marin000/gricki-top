{
  "expo": {
    "name": "Grički top",
    "slug": "gricki-top",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "grickitop",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.grickitop.app",
      "infoPlist": {}
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4EFDF",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.grickitop.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4EFDF"
        }
      ],
      "expo-localization",
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#174F78"
        }
      ],
      "expo-av",
      "expo-keep-awake",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-dontwarn expo.modules.core.interfaces.services.KeepAwakeManager\n-keep class expo.modules.core.interfaces.services.KeepAwakeManager { *; }\n-keep class expo.modules.keepawake.** { *; }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ba54b812-3cc9-4d7c-bcb7-fefd7948993b"
      }
    },
    "owner": "marin1997",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ba54b812-3cc9-4d7c-bcb7-fefd7948993b"
    }
  }
}
