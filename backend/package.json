{
	"name": "gricki-top-backend",
	"version": "1.0.0",
	"private": true,
	"main": "dist/index.js",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.js",
		"build": "tsc",
		"lint": "biome check .",
		"format": "biome format .",
		"format-fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"content:validate": "tsx scripts/content-validate.ts",
		"content:seed": "tsx scripts/content-seed.ts",
		"content:reset-schedule": "tsx scripts/content-reset-schedule.ts"
	},
	"dependencies": {
		"cors": "^2.8.6",
		"dotenv": "^16.4.7",
		"express": "^5.2.1",
		"express-validator": "^7.2.1",
		"luxon": "^3.7.2",
		"mongoose": "^8.13.2",
		"uuid": "^11.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/luxon": "^3.7.1",
		"@types/node": "^22.13.10",
		"@types/uuid": "^10.0.0",
		"tsx": "^4.19.3",
		"typescript": "^5.8.2"
	}
}
